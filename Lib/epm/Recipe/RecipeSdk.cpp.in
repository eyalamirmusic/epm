#include <epm/Recipe/RecipeSdk.h>
#include <epm/Util/Text.h>

// Generated from Lib/epm/Recipe/RecipeSdk.cpp.in: configure_file fills in the
// variables and file(GENERATE) the generator expressions, once per
// configuration. Lists are CMake lists.

namespace epm
{
namespace
{
std::string identityOf(const RecipeSdk& sdk)
{
    auto lines = eacp::Vector<std::string> {sdk.compiler,
                                            sdk.compilerId,
                                            sdk.cxxStandard,
                                            sdk.cxxExtensions ? "ON" : "OFF",
                                            eacp::Strings::join(sdk.flags, " "),
                                            sdk.osxSysroot,
                                            eacp::Strings::join(sdk.osxArchitectures, " "),
                                            sdk.osxDeploymentTarget,
                                            eacp::Strings::join(sdk.includeDirectories, " "),
                                            eacp::Strings::join(sdk.compileDefinitions, " "),
                                            eacp::Strings::join(sdk.compileOptions, " ")};

    return eacp::Strings::join(lines, "\n");
}

RecipeSdk bakedSdk()
{
    auto sdk = RecipeSdk {};
    sdk.compiler = R"epmsdk(@CMAKE_CXX_COMPILER@)epmsdk";
    sdk.compilerId = R"epmsdk(@CMAKE_CXX_COMPILER_ID@)epmsdk";
    sdk.cxxStandard = R"epmsdk(@CMAKE_CXX_STANDARD@)epmsdk";
    sdk.cxxExtensions = std::string {"@EPM_SDK_CXX_EXTENSIONS@"} == "ON";
    sdk.flags = splitList(R"epmsdk(@EPM_SDK_CXX_FLAGS@)epmsdk");
    sdk.osxSysroot = R"epmsdk(@CMAKE_OSX_SYSROOT@)epmsdk";
    sdk.osxArchitectures = splitList(R"epmsdk(@EPM_SDK_OSX_ARCHITECTURES@)epmsdk");
    sdk.osxDeploymentTarget = R"epmsdk(@CMAKE_OSX_DEPLOYMENT_TARGET@)epmsdk";
    sdk.includeDirectories = splitList(
        R"epmsdk($<REMOVE_DUPLICATES:$<TARGET_PROPERTY:epm-core,INCLUDE_DIRECTORIES>;$<TARGET_PROPERTY:epm-core,INTERFACE_INCLUDE_DIRECTORIES>>)epmsdk");
    sdk.compileDefinitions =
        splitList(R"epmsdk($<TARGET_PROPERTY:epm-core,COMPILE_DEFINITIONS>)epmsdk");
    sdk.compileOptions =
        splitList(R"epmsdk($<TARGET_PROPERTY:epm-core,COMPILE_OPTIONS>)epmsdk");
    sdk.identity = identityOf(sdk);
    return sdk;
}
} // namespace

const RecipeSdk& recipeSdk()
{
    static const auto sdk = bakedSdk();
    return sdk;
}
} // namespace epm
