# The consumer of Tests/GraphNested.cmake: declares only Mid, and reaches Leaf
# through it. Its epm.cpp is also built as ConsumerRecipe.
cmake_minimum_required(VERSION 3.25)
list(APPEND CMAKE_PROJECT_TOP_LEVEL_INCLUDES "@GET_EPM@")
project(NestedConsumer CXX)

find_package(Mid REQUIRED)

add_executable(app Main.cpp)
target_link_libraries(app PRIVATE Mid::Mid)

epm_add_recipe(ConsumerRecipe)
